# SourcePilot runtime
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
WEB_PORT=5173
DATABASE_URL=postgresql+asyncpg://sourcepilot:sourcepilot@postgres:5432/sourcepilot
WEB_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
COMPANY_NAME=IT Essentials (ITE)
COMPANY_LOCATION=Sharjah, United Arab Emirates
COMPANY_COUNTRY=United Arab Emirates
DEFAULT_CURRENCY=AED
PROCUREMENT_REGION=UAE
SOURCING_REGIONS=["United Arab Emirates","GCC"]

# Agent execution
WORKFLOW_POLL_SECONDS=2
MAX_CONCURRENT_WORKFLOWS=2
MAX_CONCURRENT_TOOLS=5
PROVIDER_TIMEOUT_SECONDS=20
PROVIDER_MAX_RETRIES=2
RESEARCH_MAX_ROUNDS=2

# LLM: openai or openrouter
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Research: exa or firecrawl. Configure at least one for live workflows.
SEARCH_PROVIDER=exa
EXA_API_KEY=
FIRECRAWL_API_KEY=
